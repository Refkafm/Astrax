CREATE TABLE settings (id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1), zone TEXT NOT NULL DEFAULT 'Asia/Jakarta', anchor INTEGER NOT NULL DEFAULT 1 CHECK(anchor BETWEEN 1 AND 31), started TEXT NOT NULL, onboarded INTEGER NOT NULL DEFAULT 0);
CREATE TABLE accounts (id TEXT NOT NULL PRIMARY KEY, name TEXT NOT NULL, type TEXT NOT NULL CHECK(type IN ('bank','e_wallet','cash')), opening INTEGER NOT NULL CHECK(opening >= 0), opened INTEGER NOT NULL, archived INTEGER NOT NULL DEFAULT 0 CHECK(archived IN (0,1)));
CREATE TABLE entries (id TEXT NOT NULL PRIMARY KEY, command TEXT NOT NULL UNIQUE, type TEXT NOT NULL CHECK(type IN ('expense','income','transfer','refund','adjustment')), account TEXT NOT NULL REFERENCES accounts(id), destination TEXT REFERENCES accounts(id), amount INTEGER NOT NULL CHECK(amount BETWEEN -999999999999 AND 999999999999 AND amount != 0), category TEXT NOT NULL DEFAULT '', merchant TEXT NOT NULL DEFAULT '', note TEXT NOT NULL DEFAULT '', occurred INTEGER NOT NULL, business_date TEXT NOT NULL, zone TEXT NOT NULL, refund_of TEXT REFERENCES entries(id), parent TEXT REFERENCES entries(id), deleted INTEGER, CHECK((type='adjustment') OR amount>0), CHECK((type='transfer' AND destination IS NOT NULL AND destination != account) OR (type!='transfer' AND destination IS NULL)));
CREATE INDEX entry_date ON entries(business_date,type,deleted);
CREATE INDEX entry_account ON entries(account,business_date);
CREATE INDEX entry_destination ON entries(destination,business_date);
CREATE INDEX entry_refund ON entries(refund_of);
CREATE TABLE budgets (start TEXT NOT NULL PRIMARY KEY, end_date TEXT NOT NULL, total INTEGER NOT NULL CHECK(total >= 0), revision INTEGER NOT NULL DEFAULT 1, updated INTEGER NOT NULL);
CREATE TABLE allocations (period TEXT NOT NULL REFERENCES budgets(start), category TEXT NOT NULL, amount INTEGER NOT NULL CHECK(amount >= 0), PRIMARY KEY(period,category));
CREATE TABLE templates (id TEXT NOT NULL PRIMARY KEY, name TEXT NOT NULL, account TEXT NOT NULL REFERENCES accounts(id), category TEXT NOT NULL, direction TEXT NOT NULL CHECK(direction IN ('expense','income')), amount INTEGER NOT NULL CHECK(amount>0), cadence TEXT NOT NULL CHECK(cadence IN ('monthly','weekly')), first_date TEXT NOT NULL, active INTEGER NOT NULL DEFAULT 1 CHECK(active IN (0,1)));
CREATE TABLE bills (id TEXT NOT NULL PRIMARY KEY, template TEXT NOT NULL REFERENCES templates(id), due TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'unpaid' CHECK(state IN ('unpaid','paid','skipped')), entry TEXT UNIQUE REFERENCES entries(id), amount_override INTEGER CHECK(amount_override BETWEEN 1 AND 999999999999), UNIQUE(template,due));
CREATE TABLE receipts (command TEXT NOT NULL PRIMARY KEY, entity TEXT NOT NULL, operation TEXT NOT NULL);

CREATE TABLE categories (name TEXT NOT NULL, type TEXT NOT NULL CHECK(type IN ('expense','income')), archived INTEGER NOT NULL DEFAULT 0 CHECK(archived IN (0,1)), is_system INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(name,type));
